@using RaceDay.Web.Helpers
@model RaceDay.Web.Models.EventDetailsDto
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4 border-0 shadow-lg">
    @if (!string.IsNullOrEmpty(Model.BannerImage))
    {
        <img src="@Model.BannerImage" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: cover; border-top-left-radius: 12px; border-top-right-radius: 12px;">
    }
    <div class="card-body p-5">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h1 class="display-5 fw-bold">@Model.Name</h1>
            <span class="badge bg-primary fs-5">@Model.EventType</span>
        </div>

        <h5 class="text-muted mb-4">
            <i class="bi bi-calendar-event"></i> @Model.EventDate.ToString("dddd, dd MMMM yyyy - HH:mm") <br />
            <i class="bi bi-geo-alt"></i> @Model.Location <br />
            <i class="bi bi-signpost"></i> @Model.Distance km
        </h5>

        <p class="lead">@Model.Description</p>
    </div>
</div>

<h3 class="fw-bold mt-5 mb-4">Available Categories</h3>

@if (Context.Session.GetString("MvcUserRole") == "Participant")
{
    <div class="row">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 p-3 bg-dark border-secondary">
                    <h5 class="fw-bold text-primary">@cat.Name</h5>
                    <p class="text-muted small mb-2">@cat.Description</p>
                    <p class="mb-1"><strong>Age:</strong> @(cat.MinAge.HasValue ? $"{cat.MinAge}-{cat.MaxAge}" : "Open")</p>
                    <p class="mb-3"><strong>Fee:</strong> R @cat.EntryFee?.ToString("0.00")</p>

                    <form asp-action="Enrol" method="post" class="mt-auto">
                        <input type="hidden" name="eventId" value="@Model.EventID" />
                        <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                        <button type="submit" class="btn btn-primary w-100">Enrol Now</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else if (!Context.Session.IsAuthenticated())
{
    <div class="alert alert-warning">
        Please <a asp-controller="Account" asp-action="Login" class="fw-bold">Log in</a> as a Participant to enrol in this event.
    </div>
}
else
{
    <div class="alert alert-info">
        Organisers cannot enrol in events.
    </div>
}

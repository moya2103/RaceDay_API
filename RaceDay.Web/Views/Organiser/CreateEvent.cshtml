@model RaceDay.Web.Models.CreateEventDto
@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-lg p-5">
            <h2 class="fw-bold mb-4 text-primary">Create New Event</h2>

            <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Event Name</label>
                    <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Cape Town Marathon" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the event..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label fw-bold">Date & Time</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label fw-bold">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Durban" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label fw-bold">Distance (km)</label>
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" placeholder="e.g. 42.2" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="BannerImage" class="form-label fw-bold">Event Banner Image (Optional)</label>
                    <input asp-for="BannerImage" type="file" accept="image/*" class="form-control" />
                    <small class="text-muted">Upload a nice landscape image for the event card.</small>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Create Event & Add Categories</button>
            </form>
        </div>
    </div>
</div>
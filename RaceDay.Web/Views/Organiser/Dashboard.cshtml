@model IEnumerable<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">Manage Events</h1>
    <a asp-action="CreateEvent" class="btn btn-primary btn-lg fw-bold">+ Create New Event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-dark text-center py-5 border-secondary">
        <h4 class="text-muted">No events found in the system.</h4>
        <a asp-action="CreateEvent" class="btn btn-primary mt-3">Create Your First Event</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card p-4 h-100">
                    <div class="d-flex justify-content-between">
                        <h4 class="fw-bold text-primary text-truncate">@ev.Name</h4>
                        <span class="badge bg-secondary">@ev.EventType</span>
                    </div>
                    <p class="text-muted mb-3">@ev.EventDate.ToString("dd MMM yyyy") | @ev.Location</p>

                    <div class="mt-auto d-flex flex-column gap-2">
                        <div class="d-flex gap-2">
                            <a asp-action="ManageCategories" asp-route-eventId="@ev.EventID" class="btn btn-outline-warning btn-sm w-50">Categories</a>
                            <a asp-action="ViewEnrolments" asp-route-eventId="@ev.EventID" class="btn btn-outline-info btn-sm w-50">Enrolments</a>
                        </div>

                        <form asp-action="DeleteEvent" asp-route-eventId="@ev.EventID" method="post" onsubmit="return confirm('Are you sure you want to delete this event? This cannot be undone.');">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Delete Event</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

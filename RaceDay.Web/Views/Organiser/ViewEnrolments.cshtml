@model IEnumerable<RaceDay.Web.Models.OrganiserEnrolmentDto>
@{
    ViewData["Title"] = "View Enrolments";
    int eventId = ViewBag.EventId;
}

<div class="mb-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
    <h1 class="fw-bold">Enrolments for: <span class="text-primary">@ViewBag.EventName</span></h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-dark text-center py-4 border-secondary">
        <p class="mb-0 text-muted">No participants have enrolled yet.</p>
    </div>
}
else
{
    <div class="card p-0 overflow-hidden">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrol in Model)
                {
                    <tr>
                        <td>
                            <strong>@enrol.Participant.Name</strong><br />
                            <small class="text-muted">@enrol.Participant.Email</small>
                        </td>
                        <td>@enrol.Category</td>
                        <td>
                            @{
                                string statusBadge = enrol.Status == "Confirmed" ? "bg-success text-dark" :
                                enrol.Status == "Pending" ? "bg-warning text-dark" :
                                enrol.Status == "Completed" ? "bg-primary" : "bg-secondary";
                            }
                            <span class="badge @statusBadge">@enrol.Status</span>
                        </td>
                        <td>
                            @if (enrol.PaymentStatus == "Paid")
                            {
                                <span class="text-success">Paid</span>
                            }
                            else
                            {
                                <span class="text-danger">Unpaid</span>
                            }
                        </td>
                        <td>
                            <form asp-action="UpdateEnrolmentStatus" method="post" class="d-flex gap-2">
                                <input type="hidden" name="enrolmentId" value="@enrol.EnrolmentID" />
                                <input type="hidden" name="eventId" value="@eventId" />

                                @if (enrol.Status == "Pending")
                                {
                                    <button type="submit" name="status" value="Confirmed" class="btn btn-sm btn-success">Confirm</button>
                                }
                                else if (enrol.Status == "Confirmed")
                                {
                                    <a asp-action="CaptureResult" asp-route-enrolmentId="@enrol.EnrolmentID" asp-route-eventId="@eventId" class="btn btn-sm btn-primary">Capture Result</a>
                                }
                                else if (enrol.Status == "Completed")
                                {
                                    <span class="text-muted fw-bold">Finished</span>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
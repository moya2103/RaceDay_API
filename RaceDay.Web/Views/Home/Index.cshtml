@model IEnumerable<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="text-center mb-5 mt-3">
    <h1 class="display-4 fw-bold" style="color: var(--primary-lime);">RACE DAY IS COMING</h1>
    <p class="lead">Find your next challenge. Run, walk, or cycle across South Africa.</p>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center mt-5">
            <h4 class="text-muted">No events found. Check back later!</h4>
        </div>
    }
    else
    {
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(ev.BannerImage))
                    {
                        <img src="@ev.BannerImage" class="card-img-top" alt="@ev.Name" style="height: 200px; object-fit: cover; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                            <span class="fw-bold fs-4">RACE DAY</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-dark border border-secondary text-light">@ev.EventType.ToUpper()</span>
                            <small class="text-muted">@ev.EventDate.ToString("dd MMM yyyy")</small>
                        </div>

                        <h4 class="card-title fw-bold text-truncate">@ev.Name</h4>
                        <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill"></i> @ev.Location | @ev.Distance km</p>

                        <div class="mt-auto">
                            <a asp-controller="Event" asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-primary w-100">View Event</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@model IEnumerable<RaceDay.Web.Models.ParticipantResultDto>
@{
    ViewData["Title"] = "My Results";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">My Race History</h1>
</div>

@if (!Model.Any())
{
    <div class="alert alert-dark text-center py-5 border-secondary">
        <h4 class="text-muted">You don't have any results yet.</h4>
        <p class="text-muted">Once an Organiser captures your finish time, it will appear here.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Find a Race</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var res in Model)
        {
            <div class="col-12 mb-3">
                <div class="card p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <h4 class="fw-bold text-primary mb-1">@res.Event</h4>
                            <p class="text-muted mb-0">@res.Date.ToString("dd MMM yyyy") | @res.Category</p>
                        </div>

                        <div class="col-md-4 text-center my-3 my-md-0">
                            @if (res.IsCompleted && res.FinishTime != null)
                            {
                                <div class="p-3 bg-dark rounded border border-secondary">
                                    <h2 class="fw-bold mb-0 text-success">@res.FinishTime</h2>
                                    <small class="text-muted">Finish Time</small>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2">Awaiting Result</span>
                            }
                        </div>

                        <div class="col-md-4 text-md-end text-center">
                            @if (res.Position.HasValue)
                            {
                                <h3 class="fw-bold mb-0">@res.Position<sup>@GetOrdinal(res.Position.Value)</sup> Place</h3>
                                <p class="text-muted mb-0">Position</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@functions {
    public string GetOrdinal(int number)
    {
        if (number <= 0) return "";
        switch (number % 100)
        {
            case 11:
            case 12:
            case 13:
                return "th";
        }
        switch (number % 10)
        {
            case 1: return "st";
            case 2: return "nd";
            case 3: return "rd";
            default: return "th";
        }
    }
}
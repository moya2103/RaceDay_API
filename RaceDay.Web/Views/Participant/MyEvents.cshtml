@model IEnumerable<RaceDay.Web.Models.MyEnrolmentDto>
@{
    ViewData["Title"] = "My Events";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="fw-bold mb-4">My Enrolments</h2>

@if (!Model.Any())
{
    <div class="alert alert-dark text-center py-5 border-secondary">
        <h4 class="text-muted">You haven't enrolled in any events yet.</h4>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Browse Events</a>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card p-3">
                    <h4 class="fw-bold text-primary">@item.Event.Name</h4>
                    <p class="text-muted mb-1">@item.Event.EventDate.ToString("dd MMM yyyy") | @item.Event.Location</p>
                    <p class="mb-2"><strong>Category:</strong> @item.Category</p>

                    @{
                        string status = item.Status;
                        string badgeClass = status == "Confirmed" ? "bg-success text-dark" :
                        status == "Pending" ? "bg-warning text-dark" : "bg-secondary";
                    }
                    <span class="badge @badgeClass fs-6">@status</span>
                </div>
            </div>
        }
    </div>
}
